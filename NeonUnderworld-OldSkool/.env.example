DATABASE_URL="postgresql://postgres:postgres@localhost:5432/neon_underworld?schema=public"
AUTH_SECRET="dev-secret-minimum-32-characters-long-for-local"
APP_URL="http://localhost:3302"

# Google OAuth (optional — enables Continue with Google)
# Local redirect URI: http://localhost:3302/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

SEED_INVITE_CODE="NEON-ALPHA-2026"

# Optional — player PFP uploads (production on Vercel)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Install when enabling: npm install @vercel/blob --prefix NeonUnderworld-OldSkool

# Password reset (optional until live test — requires Resend + verified sender)
# RESEND_API_KEY="re_..."
# PASSWORD_RESET_FROM_EMAIL="Neon Underworld <noreply@yourdomain.com>"

# Vercel production — set these in Project → Settings → Environment Variables:
# DATABASE_URL   — Postgres connection string (Vercel Postgres or Neon/Supabase)
# AUTH_SECRET    — random 32+ char secret (openssl rand -base64 32)
# APP_URL        — https://your-app.vercel.app
# After first deploy with DATABASE_URL, run locally:
#   DATABASE_URL="your-prod-url" npm run db:seed --prefix ..
# Or create an invite code in the database manually.
#
# Optional — set to false to hide More → Add Turns when the season goes live:
# PLAYTEST_TURNS=false
# NEXT_PUBLIC_PLAYTEST_TURNS=false
#
# Closed-test round enforcement (off by default — trial play is not blocked).
# Set to true only when the official 7-day test begins:
# NU_ENFORCE_ACTIVE_SEASON=true
#
# Optional — include static local-npc fixtures in automated NPC progression (default off):
# NPC_PROGRESSION_INCLUDE_LOCAL=true

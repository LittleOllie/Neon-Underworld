DATABASE_URL="postgresql://postgres:postgres@localhost:5432/neon_underworld?schema=public"
AUTH_SECRET="dev-secret-minimum-32-characters-long-for-local"
APP_URL="http://localhost:3302"
SEED_INVITE_CODE="NEON-ALPHA-2026"

# Vercel production — set these in Project → Settings → Environment Variables:
# DATABASE_URL   — Postgres connection string (Vercel Postgres or Neon/Supabase)
# AUTH_SECRET    — random 32+ char secret (openssl rand -base64 32)
# APP_URL        — https://your-app.vercel.app
# After first deploy with DATABASE_URL, run locally:
#   DATABASE_URL="your-prod-url" npm run db:seed --prefix ..
# Or create an invite code in the database manually.
#
# Optional — set to false to hide More → Add Turns when the season goes live:
# PLAYTEST_TURNS=false
# NEXT_PUBLIC_PLAYTEST_TURNS=false

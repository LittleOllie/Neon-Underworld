{
  "name": "neon-underworld-oldskool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3302",
    "build": "next build",
    "start": "next start -p 3302",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:seed": "npm run db:seed --prefix ..",
    "db:seed:dev-pvp": "npm run db:seed:dev-pvp --prefix ..",
    "postinstall": "prisma generate --schema=../prisma/schema.prisma && rm -rf ./node_modules/.prisma/client && cp -R ../node_modules/.prisma/client ./node_modules/.prisma/client"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^1.31.0",
    "next": "15.5.22",
    "next-auth": "^5.0.0-beta.30",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}

{
  "name": "neon-underworld",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix NeonUnderworld-OldSkool",
    "build": "npm run build --prefix NeonUnderworld-OldSkool",
    "start": "npm run start --prefix NeonUnderworld-OldSkool",
    "vercel-build": "npm run db:generate && npm run vercel-build --prefix NeonUnderworld-OldSkool && rm -rf .next public && cp -R NeonUnderworld-OldSkool/.next .next && cp -R NeonUnderworld-OldSkool/public public",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm run typecheck --prefix NeonUnderworld-OldSkool",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e --prefix NeonUnderworld-OldSkool",
    "test:e2e:install": "npm run test:e2e:install --prefix NeonUnderworld-OldSkool",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev-pvp": "tsx scripts/seed-dev-pvp-opponents.ts",
    "db:backfill-turns": "tsx scripts/backfill-canonical-turn-state.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^1.28.0",
    "next": "15.5.22",
    "next-auth": "^5.0.0-beta.30",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/neon_underworld?schema=public"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret"

# Google OAuth (optional — enables Continue with Google on login/register)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (local): http://localhost:3302/api/auth/callback/google
# Authorized redirect URI (production): https://your-app.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Application URL
APP_URL="http://localhost:3302"

# Vercel production — Project → Settings → Environment Variables:
# DATABASE_URL   — Postgres connection string (Neon, Supabase, Vercel Postgres, etc.)
# AUTH_SECRET      — random 32+ char secret (openssl rand -base64 32)
# APP_URL          — https://your-app.vercel.app
# After first deploy with DATABASE_URL, seed from your machine:
#   DATABASE_URL="your-prod-url" npm run db:seed

# Seed data (development only)
SEED_ADMIN_EMAIL="admin@neonunderworld.local"
SEED_ADMIN_PASSWORD="AdminChangeMe123!"
SEED_INVITE_CODE="NEON-ALPHA-2026"
